{
  "$schema": "vscode://schemas/icon-theme",
  // 图标定义：每个 key 是一个逻辑图标 ID，iconPath 相对本文件
  "iconDefinitions": {
    "_file": { "iconPath": "./default_file.svg" },
    "_folder": { "iconPath": "./default_folder.svg" },
    "_folder_open": { "iconPath": "./default_folder_opened.svg" },
    "_src_folder": { "iconPath": "./folder_src.svg" },
    "_ts": { "iconPath": "./typescript.svg" },
    "_json": { "iconPath": "./json.svg" },
    "_md": { "iconPath": "./markdown.svg" }
  },
  // 按文件名精确匹配，优先级最高
  "fileNames": {
    "package.json": "_json",
    "tsconfig.json": "_json",
    "README.md": "_md"
  },
  // 按扩展名匹配
  "fileExtensions": {
    "ts": "_ts",
    "json": "_json",
    "md": "_md"
  },
  // 按语言 ID 匹配（可选，优先级低于 fileNames / fileExtensions）
  "languageIds": {
    "typescript": "_ts",
    "json": "_json",
    "markdown": "_md"
  },
  // 文件夹名匹配
  "folderNames": {
    "src": "_src_folder"
  },
  // 默认兜底图标（必须提供）
  "file": "_file",
  "folder": "_folder",
  "folderExpanded": "_folder_open",
  // 展开文件夹时是否隐藏箭头
  "hidesExplorerArrows": false
}
